{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Berlin",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "customManagers": [
    {
      "customType": "regex",
      "description": "The pinned gitleaks release the CI history scan downloads",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "gitleaks/releases/download/v(?<currentValue>[0-9.]+)/"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "The Renovate release the config validator in CI runs; the app runs Renovate's latest, so this follows it.",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "--package renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+) "
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "CI tests on the python the PVE 9 hosts run (Debian 13 ships 3.13); a newer line in CI would pass what the hosts cannot run.",
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.13(\\.|$)/"
    }
  ]
}
